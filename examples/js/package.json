{
  "dependencies": {
    "zigpkg": "file:../.."
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "parcel": "^2.16.4",
    "typescript": "^6.0.3",
    "vite-plugin-commonjs": "^0.10.4",
    "vite": "^8.0.10"
  },
  "scripts": {
    "prestart": "tsc -p .",
    "start": "node build/example.js",
    "start:esbuild": "esbuild --bundle example.ts --outfile=dist/esbuild.js",
    "start:parcel": "parcel --no-autoinstall index.html",
    "start:vite": "vite"
  },
  "alias": {
    "process": {
      "global": "process"
    }
  },
  "staticFiles": {
    "staticPath": "node_modules/zigpkg/build/lib/zigpkg.wasm"
  }
}

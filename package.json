{
  "name": "zigpkg",
  "version": "0.1.0",
  "description": "Example Zig project demonstrating a library usable in C/Node/WASM/Zig",
  "repository": "github:scheibo/zigpkg",
  "license": "0BSD",
  "sideEffects": false,
  "main": "build/pkg/index.js",
  "types": "build/pkg/index.d.ts",
  "browser": {
    "./build/pkg/node.js": "./build/pkg/browser.js"
  },
  "files": [
    "build.zig",
    "build/pkg/browser.d.ts",
    "build/pkg/browser.js.map",
    "build/pkg/browser.js",
    "build/pkg/index.d.ts",
    "build/pkg/index.js.map",
    "build/pkg/index.js",
    "build/pkg/node.d.ts",
    "build/pkg/node.js.map",
    "build/pkg/node.js",
    "src/bin/install-zigpkg",
    "src/lib/napi.h",
    "src/lib/node.zig",
    "src/lib/options.zig",
    "src/lib/wasm.zig",
    "src/lib/zigpkg.zig"
  ],
  "engines": {"node": ">=16.0.0"},
  "bin": {"install-zigpkg": "src/bin/install-zigpkg"},
  "devDependencies": {
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "binaryen": "^129.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-jest": "^29.15.2",
    "globals": "^17.6.0",
    "jest": "^30.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "scripts": {
    "lint": "eslint --cache src",
    "fix": "eslint --fix src",
    "compile": "tsc -p .",
    "test": "jest",
    "postinstall": "node src/bin/install-zigpkg"
  },
  "jest": {
    "collectCoverageFrom": [ "src/pkg/*.ts"],
    "coverageDirectory": "coverage/js",
    "coverageProvider": "v8",
    "testEnvironment": "node",
    "testPathIgnorePatterns": ["node_modules/", "build/"]
  },
  "babel": {
    "presets": ["@babel/preset-typescript",["@babel/preset-env", {"targets": {"node": "current"}}]]
  }
}
